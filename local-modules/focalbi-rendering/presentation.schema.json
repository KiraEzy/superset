{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional native dashboard chart presentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterId", "single", "multiple"],
      "properties": {
        "filterId": { "type": "string", "minLength": 1 },
        "single": { "type": "string" },
        "multiple": { "type": "string" }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterId", "dimension", "selectedColors", "otherColor"],
      "properties": {
        "filterId": { "type": "string", "minLength": 1 },
        "dimension": { "type": "string", "minLength": 1 },
        "selectedColors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/color" }
        },
        "otherColor": { "$ref": "#/$defs/color" },
        "labelColors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/color" }
        }
      }
    },
    "secondaryBehindPrimary": { "type": "boolean" }
  },
  "$defs": { "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
}
