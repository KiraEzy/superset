# Offline cutover build from an audited local dependency snapshot.
# Runtime environment/secrets and /tmp artifacts are not copied into the final image.
FROM focalbi-ai-precutover:20261025 AS dependencies
FROM apachesuperset.docker.scarf.sh/apache/superset@sha256:5822dff49c41fd745ce33e38af502f9c64df30d133aeba148c5d89b35a1004ef
USER root
COPY --from=dependencies /app/.venv /app/.venv
COPY --from=dependencies /tmp/focal-agents-validation /opt/focal-ai
RUN /opt/focal-ai/bin/python -m pip check
