  "dataset_metric_overrides": {
    "summary": {
      "elderly_dependency_per_1000": {
        "metric_name": "elderly_dependency_per_1000",
        "verbose_name": "65+ per 1,000 aged 15-64",
        "expression": "1000.0 * SUM(elderly_population) / NULLIF(SUM(population) - SUM(children_population) - SUM(elderly_population), 0)",
        "description": "Residents aged 65+ per 1,000 residents aged 15-64. Derived from 2021 district census age counts; not a measure of employment or financial dependence.",
        "d3format": ".1f"
      }
    },
    "housing": {
      "housing_sort_order": {
        "expression": "MIN(category_order)",
        "verbose_name": "Housing display order",
        "metric_name": "housing_sort_order"
      },
      "housing_households": {
        "expression": "SUM(count_value)",
        "verbose_name": "Domestic households",
        "d3format": ",.0f",
        "metric_name": "housing_households"
      },
      "housing_share_pct": {
        "expression": "100.0 * SUM(count_value) / NULLIF(SUM(SUM(count_value)) OVER (), 0)",
        "verbose_name": "Household share (%)",
        "d3format": ".2f",
        "metric_name": "housing_share_pct"
      },
      "housing_total": {
        "expression": "SUM(SUM(count_value)) OVER ()",
        "verbose_name": "Selected domestic households",
        "d3format": ",.0f",
        "metric_name": "housing_total"
      },
      "housing_cells_json": {
        "expression": "'[' || REPEAT('1,', ((ROUND(200.0 * SUM(SUM(count_value)) OVER (ORDER BY category_order, category_label ROWS UNBOUNDED PRECEDING) / NULLIF(SUM(SUM(count_value)) OVER (), 0)) - ROUND(200.0 * (SUM(SUM(count_value)) OVER (ORDER BY category_order, category_label ROWS UNBOUNDED PRECEDING) - SUM(count_value)) / NULLIF(SUM(SUM(count_value)) OVER (), 0))))::integer) || 'null]'",
        "verbose_name": "Waffle display cells",
        "description": "200 cells allocated by differences of rounded cumulative shares; exact counts remain separate. The trailing null is ignored by the template.",
        "metric_name": "housing_cells_json"
      }
    }
  },
